PUBLIC_URL=https://codex.starvalley.fun
PORT=3100
DATA_DIR=/data
# This must be the actual HOST path backing /data (worker bind mounts use it).
HOST_DATA_DIR=/home/zhuzi/apps/web-codex-server/data
WORKER_IMAGE=starvalley-codex-worker:local
INVITE_CODE=replace-with-a-long-random-invite
COOKIE_SECURE=true
MAX_USERS=10
USER_QUOTA_MB=512
MAX_FILE_MB=256
WORKER_MEMORY_MB=384
MAX_ACTIVE_WORKERS=2
# Enable only after independently verifying nested Codex sandbox support.
ENABLE_NESTED_SANDBOX=false
# Explicit host root backend, available only to the superadmin role in server mode.
ENABLE_HOST_EXECUTION=false
HOST_CODEX_SCRIPT=/home/zhuzi/.local/lib/node_modules/@openai/codex/bin/codex.js
HOST_CODEX_BIN=/home/zhuzi/.local/bin
# Optional: a trusted administrator-created config.toml and auth.json template.
# Template is used only for invited accounts, never committed or returned by API.
CODEX_TEMPLATE_DIR=/data/template
