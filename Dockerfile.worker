FROM node:24-bookworm-slim
ARG CODEX_VERSION=0.162.1
RUN apt-get update && apt-get install -y --no-install-recommends git python3 curl ca-certificates ripgrep openssh-client unzip procps && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex@${CODEX_VERSION} && npm cache clean --force
ENV HOME=/home/node CODEX_HOME=/home/node/.codex
USER 1000:1000
WORKDIR /workspace
CMD ["sleep", "infinity"]
